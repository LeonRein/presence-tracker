# Copy to secrets.yaml (it is git-ignored). In the Device Builder these keys
# go into the existing /config/esphome/secrets.yaml.
wifi_ssid: "MyWiFi"
wifi_password: "..."
wifi_ap_password: "..."
api_key: "<32 byte base64, e.g. from `openssl rand -base64 32`>"
# Mosquitto add-on: IP of Home Assistant, user from the add-on's "logins" or a HA user
mqtt_broker: "192.168.178.3"
mqtt_username: "presence"
mqtt_password: "..."
